<head>
  <link rel="stylesheet" href="<%= baseUrl -%>.well-known/css/styles/oidc/consent.css" type="text/css">
  <!-- <script type="module" src="<%= baseUrl -%>.well-known/css/scripts/util.js"></script> -->
  <script src="https://cdn.jsdelivr.net/npm/js-sha512@0.9.0/src/sha512.min.js" defer></script>
</head>

<h1>Consenso al trattamento dei dati personali e sensibili (D. Lgs 196/2003 - Art. 23)</h1>

<p class="error" id="error"></p>

<section id="consent">
  <hr/>

  <h3>DATI ANAGRAFICI</h3>

  <form method="post" id="mainForm">
    <label for="name">Il/la sottoscritta:</label>
    <input type="text" id="name" name="name" required />

    <label for="birthPlace">nato/a a:</label>
    <input type="text" id="birthPlace" name="birthPlace" required />

    <label for="birthDate">il:</label>
    <input type="date" id="birthDate" name="birthDate" required />

    <label for="residence">residente in:</label>
    <input type="text" id="residence" name="residence" required />

    <label for="street">alla via:</label>
    <input type="text" id="street" name="street" required />

    <label for="cf">codice fiscale:</label>
    <input type="text" id="cf" name="cf" required />
    
    <br/>

    <p>
      Dichiara di aver letto e compreso le informazioni fornite a norma
      dell'art.13 del D.lgs. 196/2003 e consapevole, in particolare, che
      il trattamento riguarderà i dati “sensibili” di cui all'art 4, comma 1 lett. d)
      del citato decreto, vale a dire
      <em>
        “i dati personali idonei a rivelare l'origine razziale ed etnica, le convinzioni religiose, filosofiche o di altro genere, 
        le opinioni politiche, l'adesione a partiti, sindacati, associazioni od organizzazioni a carattere religioso, filosofico,
        politico o sindacale, nonché i dati idonei a rivelare lo stato di salute e la vita sessuale”
      </em>,
    </p>

    <br/>

    <p style="text-align: center;"><strong>PRESTA</strong></p>

    <br/>

    <p>
      libero, consapevole, informato e specifico consenso al trattamento, anche con strumenti informatici e/o telematici,
      dei dati personali e sensibili per fini diagnostico-terapeutici limitatamente ai servizi sanitari richiesti e necessari alla tutela della propria salute,
      alla Piattaforma informatica <strong>"<span class="client-name"></span>"</strong>, cui possono accedere medici prescrittori e centri erogatori (farmacie pubbliche e private)
      al fine di garantire continuità dei trattamenti sanitari attinenti alla propria specifica patologia,
      per i dovuti adempimenti amministrativi e per tutte le altre attività connesse, compresa la comunicazione dei dati nelle forme e nei modi indicati nell'informativa.
    </p>

    <hr/>

    <h3>INFORMATIVA PRIVACY</h3>

    <p>
      Ai sensi dell'art. 13 del Decreto Legislativo 30 giugno 2003, n. 196 - recante disposizione in materia di protezione dei dati personali, si rendono le seguenti informazioni:
    </p>

    <ul>
      <li>
        I dati personali sono richiesti, raccolti e trattati per lo svolgimento delle specifiche funzioni istituzionali e nei limiti previsti dalla relativa normativa;
      </li>
      <li>
        L'accesso ai dati è consentito esclusivamente ai medici prescrittori e centri erogatori tramite un doppio sistema di filtro costituito sia dalle credenziali
        richieste per l'accesso al sistema <strong>"<span class="client-name"></span>"</strong> sia dalla specifica autenticazione tramite i codici riportati sulla propria tessera sanitaria;
      </li>
      <li>
        La comunicazione o la diffusione dei dati personali a soggetti pubblici o privati sarà effettuata solo se prevista da norme di legge o di regolamento
        o se risulta necessaria per  fini diagnostico - terapeutici;
      </li>
      <li>
        L'interessato potrà in ogni momento esercitare i diritti di cui all'art. 7 del D.Lgs. 30 giugno 2003 n. 196.
      </li>
    </ul>
    <p>
      Il titolare dei dati trattati è la piattaforma <strong>"<span class="client-name"></span>"</strong>.  
    </p>

    <hr/>

    <h3>SELEZIONE WEBID</h3>

    <fieldset>
      <ol id="webIdList">
      </ol>
    </fieldset>

    <fieldset>
      <ol>
        <li class="checkbox">
          <label><input type="checkbox" name="remember" value="true" checked>Remember this client</label>
        </li>
      </ol>
    </fieldset>

    <hr/>

    <label for="signature-date">Data e ora: <span id="signature-date"></span></label>

    <hr/>

    <input type="hidden" id="contractHash" name="contractHash" />
    <input type="hidden" id="sha512Audit" name="sha512Audit" />

    <p class="actions">
      <button type="button" id="signatureButton">Firma con MetaMask</button>
      <input type="hidden" id="signature" name="signature" required />

      <button id="authorize" type="submit" disabled autofocus>Autorizza</button>
      <button id="cancel" type="button">Cancella</button>
      <button id="edit-account" type="button" class="alternate">Modifica account</button>
      <button id="switch-account" type="button" class="alternate">Usa un account diverso</button>
    </p>
  </form>
</section>

<script>
  // Retrieve and display client information
  (async() => {
    const controls = await fetchControls('<%= idpIndex %>');

    wireButtons(controls);

    const { webIds } = await fetchJson(controls.oidc.webId);
    if (webIds.length === 0) {
      setError('No WebIDs are assigned to this account. Edit the account to add one.');
    }
    setVisibility('authorize', webIds.length > 0);

    // List WebIDs on page
    for (const webId of webIds) {
      webIdList.insertAdjacentHTML('beforeend', `
        <li class="radio">
          <label for="${webId}">
            <input id="${webId}" type="radio" name="webId" value="${webId}" ${webIds.length === 1 ? 'checked' : ''}>
            ${webId}
          </label>
        </li>`);
    }

    const { client } = await fetchJson(controls.oidc.consent);

    const client_name = client?.client_name || 'Client name not available';
    window.client_id = client?.client_id || 'Client id not available';

    document.querySelectorAll('.client-name').forEach(el => {el.textContent = client_name});
    document.querySelectorAll('.client-id').forEach(el => {el.textContent = client_id});

    addPostListener(() => consent(controls));

    // Add listeners to all WebID radio buttons
    document.querySelectorAll('input[name="webId"]').forEach(input => {
      input.addEventListener('change', async (event) => {
        const selectedWebId = event.target.value;
        selectedEthAddress = await getEthAddressFromWebId(selectedWebId);
        console.log(`WebId: ${selectedWebId} - Ethereum address: ${selectedEthAddress}`);
      });
    });

    displayFormattedDateTime('signature-date');

    // Hide authorize button
    const autBtn = document.getElementById('authorize');
    autBtn.style.display = 'none';
  })();
</script>

<script>
  // Wire up elements
  const elements = getElements();

  function wireButtons(controls) {
    elements.cancel.addEventListener('click', async() => {
      const res = await fetch(controls.oidc.cancel, { method: 'POST' });
      location.href = (await res.json()).location;
    });
    setRedirectClick('edit-account', controls.html.account.account);
    elements['switch-account'].addEventListener('click', async() => {
      await fetch(controls.account.logout, { method: 'POST' });
      location.href = controls.html.main.login;
    });
  }

  async function consent(controls) {
    // The OIDC provider does not allow us to login and consent at the same time, so these have to be separate calls
    const formData = new FormData(elements.mainForm);
    let res = await postJson(controls.oidc.webId, { webId: formData.get('webId') });
    let json = await res.json();
    if (res.status !== 200) {
      elements.error.innerText = json.message;
      return;
    }

    // This is required to update the OIDC interaction
    res = await fetch(json.location);
    if (res.status !== 200) {
      json = await res.json();
      elements.error.innerText = json.message;
      return;
    }

    // Submit to the consent API
    res = await postJson(controls.oidc.consent, { remember: Boolean(formData.get('remember')) });
    json = await res.json();
    if (res.status !== 200) {
      elements.error.innerText = json.message;
      return;
    }
    location.href = json.location;
  }
</script>

<script>
  function displayFormattedDateTime(elementId) {
    const element = document.getElementById(elementId);
    const now = new Date();

    const day = String(now.getDate()).padStart(2, '0');
    const month = String(now.getMonth() + 1).padStart(2, '0');
    const year = now.getFullYear();

    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');

    const formatted = `${day}/${month}/${year} - ${hours}:${minutes}`;
    element.textContent = formatted;
  }
</script>

<script>
  // Global variable to save the selected Ethereum address
  let selectedEthAddress = null;

  // Function to retrieve the Ethereum address
  async function getEthAddressFromWebId(webIdUrl) {
    try {
      const response = await fetch(webIdUrl, {
        headers: { 'Accept': 'text/turtle' }
      });

      if (!response.ok) {
        console.error(`HTTP error ${response.status} retrieving WebID`);
        return null;
      }

      const ttlText = await response.text();
      const ethMatch = ttlText.match(/eth:ethAddress\s+"([^"]+)"/);

      return ethMatch ? ethMatch[1] : null;
    } catch (error) {
      console.error(`Error retrieving WebID ${webIdUrl}:`, error);
      return null;
    }
  }
</script>

<script>
  async function generateConsentText(lang = 'it') {
    // Recovery of values from the DOM
    const name = document.querySelector('#name')?.value || '';
    const birthPlace = document.querySelector('#birthPlace')?.value || '';
    const birthDate = document.querySelector('#birthDate')?.value || '';
    const residence = document.querySelector('#residence')?.value || '';
    const street = document.querySelector('#street')?.value || '';
    const cf = document.querySelector('#cf')?.value || '';
    const clientName = document.querySelector('.client-name')?.textContent.trim() || '';
    const selectedWebId = document.querySelector('#webIdList input[type="radio"]:checked')?.value || '';
    const rememberClient = document.querySelector('input[name="remember"]')?.checked ? 'Sì' : 'No';
    const signatureDate = new Date().toLocaleString('it-IT');
    const signature = document.querySelector('#signature')?.value || '';

    // Loading template from server
    const response = await fetch(`<%= baseUrl %>.well-known/documents/contracts/privacy_contract.${lang}.txt`);
    
    if (!response.ok) {
      throw new Error('Errore nel caricamento del contratto');
    }
      
    let template = await response.text();

    // Replacing placeholders
    const data = {
      name,
      birthPlace,
      birthDate,
      residence,
      street,
      cf,
      clientName,
      selectedWebId,
      rememberClient,
      signatureDate,
      signature
    };

    let finalText = template;
    
    for (const key in data) {
      const regex = new RegExp(`{{${key}}}`, 'g');
      finalText = finalText.replace(regex, data[key]);
    }

    return finalText;
  }
</script>

<script>

  function validateCodiceFiscale(cf) {
    const regex = /^[A-Z]{6}[0-9]{2}[A-Z][0-9]{2}[A-Z][0-9]{3}[A-Z]$/i;
    return regex.test(cf);
  }

  document.getElementById('cf').addEventListener('blur', function () {
    const cfValue = this.value.trim().toUpperCase();
    if (!validateCodiceFiscale(cfValue)) {
      this.classList.add('invalid');
    } else {
      this.classList.remove('invalid');
    }
  });

  function isSignatureReady() {
    const form = document.getElementById('mainForm');
    const requiredFields = Array.from(form.querySelectorAll('input[required]')).filter(el => el.offsetParent !== null);

    for (let field of requiredFields) {
      if (!field.value.trim()) return false;

      if (field.id === 'cf' && !validateCodiceFiscale(field.value)) return false;
    }

    const webIdSelected = form.querySelector('input[name="webId"]:checked');

    return webIdSelected !== null;
  }

  function updateSignatureButtonState() {
    const btn = document.getElementById('signatureButton');
    
    if (btn) btn.disabled = !isSignatureReady();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('mainForm');
    const signatureBtn = document.getElementById('signatureButton');

    if (signatureBtn) {
      updateSignatureButtonState(); // stato iniziale

      form.addEventListener('input', updateSignatureButtonState);

      const webIdList = document.getElementById('webIdList');

      if (webIdList) {
        webIdList.addEventListener('change', updateSignatureButtonState);
      }
    }
  });
</script>

<script type="module">

  import { ethers, JsonRpcProvider } from "https://cdnjs.cloudflare.com/ajax/libs/ethers/6.15.0/ethers.js";

  async function signConsentWithMetaMask() {
    const statusEl = document.getElementById('walletStatus');

    try {
      if (!window.ethereum) {
        throw new Error("ERROR: MetaMask is not installed.");
      }

      // Make metamask swith to local hardhat network
      await window.ethereum.request({
        method: 'wallet_switchEthereumChain',
        params: [{ chainId: '0x7A69' }] // Hardhat
      });

      // Retrieve Ethereum address from selected webID
      const selectedWebId = document.querySelector('input[name="webId"]:checked')?.value;

      if (!selectedWebId) throw new Error("ERROR: Select a WebID.");

      const expectedAddress = await getEthAddressFromWebId(selectedWebId);

      if (!expectedAddress) throw new Error("ERROR: Ethereum address not found for the selected WebID.");

      // Request accounts from MetaMask
      const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' }).catch( err => {
        throw new Error("MetaMask error: ${err.message}");
      });

      // Check if the required account is present
      const isAvaible = accounts.some(account => account.toLowerCase() === expectedAddress.toLowerCase());

      if (!isAvaible) {
        throw new Error("ERROR: The selected WebID does not match any of the accounts in MetaMask. Please switch to the correct account.");
      }

      // Check if the required account is active
      if (accounts[0].toLowerCase() !== expectedAddress.toLowerCase()) {
        throw new Error("ERROR: Please select the account " + expectedAddress + " as active in MetaMask.");
      }

      // Get the signer
      //const provider = new ethers.BrowserProvider(window.ethereum); /* To be used when the contract is on the Ethereum network */
      const provider = new JsonRpcProvider('http://localhost:8545');  /* To be used when the contract is on the local hardhat network */
      const signer = await provider.getSigner();
      //const signerAddress = await signer.getAddress();
      
      // Sign the contract
      const finalText = await generateConsentText('it');
      //const signature = await signer.signMessage(finalText);

      // Print signature address
      //let address = await ethers.verifyMessage(finalText, signature);

      //console.log("Expected address:", expectedAddress);
      //console.log("Signer address:", signerAddress);
      //console.log("Signature address:", address);
      
      // Invoke the contract with the selected signer
      const abi = await loadAbi('<%= baseUrl %>.well-known/abi/pod-authorization.json');
      const CONTRACT_ADDRESS = '0x5fbdb2315678afecb367f032d93f642f64180aa3';
      const contract = new ethers.Contract(CONTRACT_ADDRESS, abi, signer);

      const contractHash = await sha512(finalText);
      const validUntil = Math.floor(Date.now() / 1000) + (365 * 24 * 60 * 60); // 1 year

      const clientId = window.client_id ?? (typeof client_id !== 'undefined' ? client_id : null);

      if (!clientId) throw new Error("ERROR: client_id not defined.");

      const client_name = document.querySelector('.client-name')?.textContent.trim() || '';

      if (!client_name) throw new Error("ERROR: client_name not defined.");

      const tx = await contract.grantAuthorization(contractHash, clientId, client_name, validUntil);
      const receipt = await tx.wait();

      console.log('Transaction receipt:', receipt);

      // Update UI
      document.getElementById('signature').value = signature;

      const sigBtn = document.getElementById('signatureButton');

      if (sigBtn) {
        sigBtn.textContent = 'Firmato';
        sigBtn.disabled = true;

        // Simulate clicking on the authorisation button
        const autBtn = document.getElementById('authorize');
        autBtn.click();
      }
    
    } catch (err) {
      console.error("ERROR: ", err);
      alert("ERROR: " + err.message);
    }
  }

  async function loadAbi(url) {
    const res = await fetch(url, { cache: 'no-store' });
    if (!res.ok) {
      throw new Error("ERROR: Unable to load the ABI from " + url);
    }
    return await res.json();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('signatureButton');
    if (btn) {
      btn.addEventListener('click', signConsentWithMetaMask);
    }
  });
</script>