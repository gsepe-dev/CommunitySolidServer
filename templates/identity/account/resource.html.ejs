<h1>Your account</h1>
<p class="error" id="error"></p>
<div id="passwordLogins">
  <h2>Email/password logins</h2>
  <p>The email/password logins used to identify this account.</p>
  <a id="createPasswordLogin" href="" class="link">Add login</a>
  <ul id="passwordLoginEntries"></ul>
</div>
<div id="pods">
  <h2>Pods</h2>
  <p>The pods created by this account.</p>
  <a id="createPod" href="" class="link">Create pod</a>
  <ul id="podEntries"></ul>
</div>
<div id="ethAddresses">
  <h2>Ethereum addresses</h2>
  <p>The Ethereum addresses linked to your pods.</p>
  <ul id="ethAddressEntries"></ul>
</div>
<div id="webIds">
  <h2>Registered Web IDs</h2>
  <p>
    These are the WebIDs you can authenticate as using this account.
    These WebIDs also have full control access to the pods registered for this account.
  </p>
  <a id="linkWebId" href="" class="link">Link WebID</a>
  <ul id="webIdEntries"></ul>
</div>
<div id="clientCredentials">
  <h2>Credential tokens</h2>
  <p>The tokens created by this account.</p>
  <a id="createCredentials" href="" class="link">Create token</a>
  <ul id="clientCredentialsEntries"></ul>
</div>
<p class="actions">
  <button class="hidden" type="button" id="oidc">Continue authentication</button>
  <button type="button" id="logout" name="logout">Log out</button>
</p>

<!-- Modal per autorizzazioni -->
<div id="authModal" class="modal hidden">
  <div class="modal-content">
    <span id="closeModal" class="close">&times;</span>
    <h2>Autorizzazioni</h2>
    <table id="authTable" class="auth-table">
      <thead>
        <tr>
          <th>Servizio</th>
          <th>ID</th>
          <th>Scadenza</th>
          <th>Hash Contratto</th>
          <th>Azioni</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<style>
/* Modal */
.modal {
  display:none;
  position:fixed;
  top:0; left:0;
  width:100%; height:100%;
  background:rgba(0,0,0,0.5);
}
.modal-content {
  background:#fff;
  margin:5% auto;
  padding:20px;
  width:80%;
  border-radius:8px;
  box-shadow:0 4px 10px rgba(0,0,0,0.3);
}
.close {
  float:right;
  cursor:pointer;
  font-size:20px;
  font-weight:bold;
}
.hidden { display:none; }

/* Tabella */
.auth-table {
  width:100%;
  border-collapse:collapse;
  margin-top:15px;
  font-size:14px;
}
.auth-table th, .auth-table td {
  border:1px solid #ddd;
  padding:10px;
  text-align:center;
}
.auth-table th {
  background-color:#f2f2f2;
  font-weight:bold;
}
.auth-table tr:nth-child(even) {
  background-color:#fafafa;
}
.auth-table tr:hover {
  background-color:#f1f1f1;
}

/* Bottone Revoca */
.revokeBtn {
  background-color:#d9534f;
  color:white;
  border:none;
  padding:6px 12px;
  cursor:pointer;
  border-radius:4px;
  font-size:13px;
}
.revokeBtn:hover {
  background-color:#c9302c;
}
</style>


<script type="module">
  import { ethers, JsonRpcProvider } from "https://cdnjs.cloudflare.com/ajax/libs/ethers/6.15.0/ethers.js";

  const elements = getElements('passwordLoginEntries', 'podEntries', 'webIdEntries', 'clientCredentialsEntries', 'oidc', 'logout', 'ethAddressEntries');

  // Retrieve and display client information
  (async() => {
    const controls = await fetchControls('<%= idpIndex %>');

    // Button to continue OIDC session if there is one,
    // in case someone needed to create/update the account during a session.
    setVisibility('oidc', <%= authenticating %>);
    elements.oidc.addEventListener('click', async() => {
      const body = await fetchJson(controls.oidc.prompt);
      location.href = body.location;
    });

    elements.logout.addEventListener('click', async() => {
      await fetch(controls.account.logout, { method: 'POST' });
      location.href = controls.html.main.login;
    });

    // Update email/password entries
    const { passwordLogins } = await fetchJson(controls.password.create);
    updateElement('createPasswordLogin', controls.password.create, { href: true });
    showAccountInfo(elements.passwordLoginEntries, passwordLogins, true, true,
      'Are you sure you want to delete this login method? This will prevent you from logging in to your account with these credentials.');

    // Update pod entries
    const { pods } = controls.account.pod ? await fetchJson(controls.account.pod) : {};
    if (!controls.html.account.createPod && Object.keys(pods ?? {}).length === 0) {
      setVisibility('pods', false);
    } else {
      updateElement('createPod', controls.html.account.createPod, { href: true });
      showAccountInfo(elements.podEntries, pods, true, false);
    }

    // Update Ethereum Address entries
    const podLinks = document.querySelectorAll('#podEntries a');
    const ethAddresses = {};

    for (const link of podLinks) {
      const podUrl = link.getAttribute('href');
      if (!podUrl.includes('/.account/')) {
        try {
          const cardUrl = podUrl.replace(/\/$/, '') + '/profile/card';
          const cardText = await (await fetch(cardUrl)).text();

          const match = cardText.match(/eth:ethAddress\s+"([^"]+)"/);
          if (match) {
            ethAddresses[match[1]] = "";
          }
        } catch (e) {
          console.error("ERROR: Unable to retrieve Ethereum address", podUrl, e);
        }
      }
    }

    if (Object.keys(ethAddresses).length === 0) {
      setVisibility('ethAddresses', false);
    } else {
      showAccountInfo(elements.ethAddressEntries, ethAddresses, false, false);
    }

    // Update WebID entries
    const { webIdLinks } = controls.account.webId ? await fetchJson(controls.account.webId) : {};
    if (!controls.html.account.linkWebId && Object.keys(webIdLinks ?? {}).length === 0) {
      setVisibility('webIds', false);
    } else {
      updateElement('linkWebId', controls.html.account.linkWebId, { href: true });
      showAccountInfo(elements.webIdEntries, webIdLinks, false, true,
        'Are you sure you want to delete the registration of this WebID? ' +
        'If you do so you will be unable to identify as this WebID using this server, which can potentially cause you to lose access to data restricted to this WebID.',
        'Make sure to remove the relevant solid:oidcIssuer triple from the WebID to prevent existing access tokens from still being used.');
    }

    // Update Client Credentials entries
    const { clientCredentials } = controls.account.clientCredentials ? await fetchJson(controls.account.clientCredentials) : {};
    if (!controls.html.account.createClientCredentials && Object.keys(clientCredentials ?? {}).length === 0) {
      setVisibility('clientCredentials', false);
    } else {
      // Initial boolean is so the create button gets hidden if the account has no WebIDs.
      // Currently, this does not get updated if the last WebID gets deleted, until the page is refreshed.
      updateElement('createCredentials', Object.keys(webIdLinks).length && controls.html.account.createClientCredentials, { href: true });
      showAccountInfo(elements.clientCredentialsEntries, clientCredentials, false, true,
        'Are you sure you want to delete this token? This will prevent this token from being used in the future.');
    }
  })();

  // Adds account info to the UI
  function showAccountInfo(rootElement, data, addUpdate, addDel, confirmMsg, finishMsg) {
    for (const [ key, url ] of Object.entries(data)) {
      const li = document.createElement('li');

      // If it is an Ethereum address, display it as a modal link
      if (/^0x[a-fA-F0-9]{40}$/.test(key)) {
        const span = document.createElement('span');
        span.textContent = key;
        span.className = "eth-link";
        span.style = "cursor:pointer;color:blue;text-decoration:underline;";
        li.appendChild(span);
      } else if (/^https?:\/\//.test(key)) {
        li.insertAdjacentHTML('beforeend', `<a href="${key}">${key}</a>`);
      } else {
        li.append(key);
      }


      if (addUpdate) {
        li.insertAdjacentHTML('beforeend', ` <a href="${url}">(update)</a>`);
      }


      if (addDel) {
        const del = createUrlDeleteElement(li, url, { method: 'DELETE' }, confirmMsg, finishMsg);
        li.append(' ');
        li.append(del);
      }
      rootElement.append(li);
    }
  }

  const abi = await loadAbi("<%= baseUrl %>.well-known/abi/pod-authorization.json");
  const CONTRACT_ADDRESS = "0x5fbdb2315678afecb367f032d93f642f64180aa3";

  let currentUserAddress = null;

  // Function to retrieve authorisations and populate the modal (read-only)
  async function fetchAuthorizations(userAddress) {
    currentUserAddress = userAddress.toLowerCase();

    try {
      // Reading with local provider Hardhat (suitable for viewing)
      const provider = new ethers.JsonRpcProvider("http://localhost:8545");
      const contractRead = new ethers.Contract(CONTRACT_ADDRESS, abi, provider);
      const history = await contractRead.getUserHistory(userAddress);

      const tbody = document.querySelector("#authTable tbody");
      tbody.innerHTML = "";

      if (!history || history.length === 0) {
        const tr = document.createElement("tr");
        tr.innerHTML = `<td colspan="5">Nessuna autorizzazione trovata</td>`;
        tbody.appendChild(tr);
        return;
      }

      for (const event of history) {
        const details = await contractRead.getAuthorizationDetails(userAddress, event.contractHash);
        const [appId, appName, validUntilRaw, granted] = details;
        const validUntil = Number(validUntilRaw);

        if (granted) {
          const tr = document.createElement("tr");
          tr.innerHTML = `
            <td>${appName}</td>
            <td>${appId}</td>
            <td>${new Date(validUntil * 1000).toLocaleString()}</td>
            <td>${event.contractHash}</td>
            <td><button class="revokeBtn" data-hash="${event.contractHash}">Revoca</button></td>
          `;
          tbody.appendChild(tr);
        }
      }
    } catch (err) {
      console.error("Errore fetchAuthorizations:", err);
      alert("Errore nel recupero autorizzazioni");
    }
  }

  // Delegated listener for revocation (sign with MetaMask)
  document.querySelector("#authTable tbody").addEventListener("click", async (e) => {
    if (!e.target.classList.contains("revokeBtn")) return;
    const hash = e.target.dataset.hash;

    try {
      if (!window.ethereum) throw new Error("MetaMask non disponibile.");

      // Ensure you are on the Hardhat network (chainId 0x7A69)
      await window.ethereum.request({
        method: "wallet_switchEthereumChain",
        params: [{ chainId: "0x7A69" }]
      });

      const mmProvider = new ethers.BrowserProvider(window.ethereum);
      const mmSigner = await mmProvider.getSigner();
      const mmAddress = (await mmSigner.getAddress()).toLowerCase();

      // I check that the active account is the same one clicked for the modal.
      if (mmAddress !== currentUserAddress) {
        alert("Seleziona in MetaMask l'account " + currentUserAddress + " per poter revocare.");
        return;
      }

      // Contract with MetaMask signer
      const contractWrite = new ethers.Contract(CONTRACT_ADDRESS, abi, mmSigner);

      const tx = await contractWrite.revokeAuthorization(hash);
      await tx.wait();

      alert("Autorizzazione revocata!");
      fetchAuthorizations(currentUserAddress);
    } catch (err) {
      console.error("Errore revoca:", err);
      alert("Errore nella revoca: " + (err?.message || "sconosciuto"));
    }
  });

  // Function for loading ABI
  async function loadAbi(url) {
    const res = await fetch(url, { cache: "no-store" });
    if (!res.ok) throw new Error("ERROR: Unable to load the ABI from " + url);
    return await res.json();
  }

  // Intercept clicks on Ethereum addresses
  document.getElementById("ethAddressEntries").addEventListener("click", async (e) => {
    if (!e.target.classList.contains("eth-link")) return;
    const address = e.target.textContent.trim();
    await fetchAuthorizations(address);
    document.getElementById("authModal").style.display = "block";
  });

  // Close modal
  document.getElementById("closeModal").addEventListener("click", () => {
    document.getElementById("authModal").style.display = "none";
  });
</script>
